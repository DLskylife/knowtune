# 运行期产物与个人环境，不进版本库
.venv/
__pycache__/
*.pyc
.pytest_cache/
.idea/workspace.xml
_pytest_tmp/

# 数据与模型：体积大、可重建，且含个人内容（数据库 / 上传文档 / 向量 /
# 本地 gguf / 密钥 / 本地实例日志）。整目录不上传，clone 后由程序自建。
data/
*.db
*.db-shm
*.db-wal
*.bak-*

# 开发期截图与工具会话产物
_shot/
_shot_*.png
.wbapp_*.genie
# 本地起服务时重定向的控制台日志（重启前那份会被覆盖，没有留存价值）
_serve.log

# A/B 打分台的结果与会话（含模型原文和评分，本地产物）
evals/runs/

# 提示词每次保存前的自动快照（按分钟累积，属于本机操作痕迹，不入库）
config/prompts/_history/

# 本地工作日志（含本机绝对路径与过程记录）
.workbuddy/

# 与本仓库无关的项目文档（立项/需求分析类 PDF 与渲染图，29 MB）
# 文件仍在本地，只是不上传；要一起传就把下面这行去掉
_pm/

# llama.cpp 可执行文件（约 100MB，按需下载：python scripts/get_llama.py）
tools/llama/
