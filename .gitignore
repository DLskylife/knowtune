# 运行期产物与个人环境，不进版本库
.venv/
__pycache__/
*.pyc
.pytest_cache/
.idea/workspace.xml
_pytest_tmp/

# 本地密钥与环境变量。密钥只走界面填写或环境变量，绝不入库。
.env
.env.*
!.env.example
*.key
data/secrets.json

# 数据目录：只放行「目录骨架 + 可公开的小资产」，其余全部排除。
# 数据库 / 源语料 / 模型权重体积大且含本机内容，clone 后由脚本与程序自建。
data/*
!data/README.md
!data/calibration/
!data/models/
!data/uploads/
!data/corpus/
!data/vectors/
!data/tmp/

data/calibration/*
!data/calibration/README.md
!data/calibration/.gitkeep
!data/calibration/kb_*.json
data/models/*
!data/models/README.md
!data/models/.gitkeep
data/uploads/*
!data/uploads/.gitkeep
data/corpus/*
!data/corpus/.gitkeep
data/vectors/*
!data/vectors/.gitkeep
data/tmp/*
!data/tmp/.gitkeep

*.db
*.db-shm
*.db-wal
*.bak-*
*.gguf

# 开发期截图与工具会话产物
_shot/
_shot_*.png
.wbapp_*.genie
# 本地起服务时重定向的控制台日志（重启前那份会被覆盖，没有留存价值）
_serve.log

# A/B 打分台的结果与会话（含模型原文和评分，本地产物）
evals/runs/

# 提示词每次保存前的自动快照（按分钟累积，属于本机操作痕迹，不入库）
config/prompts/_history/

# 本地工作日志（含本机绝对路径与过程记录）
.workbuddy/

# 与本仓库无关的项目文档（立项/需求分析类 PDF 与渲染图）
# 文件仍在本地，只是不上传；要一起传就把下面这行去掉
_pm/

# llama.cpp 可执行文件（约 100MB，按需下载：python scripts/get_llama.py）
# 目录骨架保留，二进制不入库
tools/llama/*
!tools/llama/README.md
!tools/llama/.gitkeep
